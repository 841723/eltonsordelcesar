---
import { business, hasBooking } from '../data/business';

const bookingHref = hasBooking ? business.bookingUrl : '#visitanos';
const bookingTarget = hasBooking && business.bookingUrl.startsWith('http') ? '_blank' : undefined;
---

<section id="inicio" class="relative isolate flex min-h-[min(850px,100svh)] items-end overflow-hidden bg-ink pb-16 pt-36 sm:pb-20 md:pb-24">
  <img
    class="absolute inset-0 -z-20 h-full w-full object-cover object-[center_43%]"
    src={business.media.hero.src}
    alt={business.media.hero.alt}
    width="1800"
    height="1200"
    fetchpriority="high"
    decoding="async"
  />
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-ink/95 via-ink/70 to-ink/20"></div>
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink/75 via-transparent to-ink/35"></div>

  <div class="page-gutter w-full">
    <div class="content-width">
      <div class="max-w-[52rem]">
        <p class="font-display mb-5 flex items-center gap-3 text-[1.2rem] font-bold uppercase tracking-[0.2em] text-white-soft/85 sm:mb-7">
          <span class="barber-stripe h-[3px] w-10" aria-hidden="true"></span>
          {business.shortName} en {business.location}
        </p>
        <h1 class="font-display max-w-[20ch] text-[clamp(3.5rem,8vw,7rem)] font-bold uppercase leading-[0.88] tracking-[-0.025em] text-paper [text-wrap:balance]">
          {business.name}
        </h1>
        <a
          class="mt-8 inline-flex min-h-12 items-center justify-center gap-4 bg-tonsor-orange px-6 font-sans text-[0.68rem] font-bold uppercase tracking-[0.15em] text-ink transition-colors duration-150 hover:bg-paper sm:mt-10"
          href={bookingHref}
          target={bookingTarget}
          rel={bookingTarget ? 'noreferrer' : undefined}
        >
          Reservar cita
          <span aria-hidden="true" class="text-base leading-none">↗</span>
        </a>
      </div>
    </div>
  </div>
</section>
