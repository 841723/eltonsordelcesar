---
import { business, hasAddress, hasPhone } from '../data/business';
---

<footer class="border-t border-white-soft/15 bg-ink px-5 py-8 text-muted sm:px-10 lg:px-20">
  <div class="content-width flex flex-col gap-5 text-xs sm:flex-row sm:items-center sm:justify-between">
    <a class="font-sans text-sm font-display uppercase tracking-wide text-white-soft" href="#inicio">{business.name}</a>
    <div class="flex flex-wrap gap-x-5 gap-y-2 text-[0.65rem] uppercase tracking-[0.12em]">
      {hasPhone && <a class="transition-colors hover:text-paper" href={`tel:${business.phone.replace(/[^+\d]/g, '')}`}>{business.phone}</a>}
      {hasAddress && <span>{business.address}</span>}
      {business.social.map((item) => <a class="transition-colors hover:text-paper" href={item.url} target="_blank" rel="noreferrer">{item.label}</a>)}
    </div>
    <p>© {new Date().getFullYear()} 
      <span class="ml-1 uppercase font-display">
        {business.name}
      </span>
    </p>
  </div>
</footer>
