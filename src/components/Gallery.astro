---
import { business } from '../data/business';

const [fade, shave, tools, barber] = business.media.gallery;
---

<section id="trabajo" class="scroll-mt-8 bg-paper py-20 text-ink sm:py-28 lg:py-36">
  <div class="page-gutter">
    <div class="content-width">
      <div class="mb-10 grid gap-7 border-b border-ink/20 pb-8 sm:mb-14 sm:grid-cols-[1.2fr_0.8fr] sm:items-end sm:pb-10">
        <div>
          <h2 class="font-display mt-4 max-w-[20ch] text-[clamp(3rem,6vw,5.5rem)] font-bold uppercase leading-[0.9] tracking-[-0.025em] text-ink [text-wrap:balance]">
            Corte limpio.<br />Estilo propio.
          </h2>
        </div>
        <div class="sm:justify-self-end sm:pb-1 sm:text-right">
          <p class="max-w-[28rem] text-sm leading-7 text-ink/75 sm:text-base">
            Degradados limpios, barba al detalle y el estilo que va contigo.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-4 lg:grid-cols-[1.05fr_0.95fr_1fr] lg:auto-rows-[17rem] lg:gap-7">
        <figure class="group relative min-h-[28rem] overflow-hidden bg-ink-raised lg:col-start-1 lg:row-start-1 lg:row-span-2 lg:min-h-0">
          <img
            class="absolute inset-0 h-full w-full object-cover object-[center_44%] transition-transform duration-200 ease-out group-hover:scale-[1.02]"
            src={fade.src}
            alt={fade.alt}
            width="1200"
            height="1798"
            loading="lazy"
            decoding="async"
          />
          <figcaption class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-4 bg-gradient-to-t from-ink/80 to-transparent p-5 pt-16 text-white-soft sm:p-7 sm:pt-20">
            <span class="font-display text-3xl font-semibold uppercase leading-none sm:text-4xl">Corte al detalle</span>
          </figcaption>
        </figure>

        <figure class="group relative min-h-[18rem] overflow-hidden bg-ink-raised lg:col-start-2 lg:row-start-1 lg:min-h-0">
          <img
            class="absolute inset-0 h-full w-full object-cover object-[center_44%] transition-transform duration-200 ease-out group-hover:scale-[1.02]"
            src={shave.src}
            alt={shave.alt}
            width="1200"
            height="800"
            loading="lazy"
            decoding="async"
          />
          <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/80 to-transparent p-5 pt-14 text-white-soft sm:p-6 sm:pt-16">
            <span class="font-display text-3xl font-semibold uppercase leading-none sm:text-4xl">Barba al punto</span>
          </figcaption>
        </figure>

        <figure class="group relative min-h-[17rem] overflow-hidden bg-ink-raised lg:col-start-2 lg:row-start-2 lg:min-h-0">
          <img
            class="absolute inset-0 h-full w-full object-cover object-[center_56%] transition-transform duration-200 ease-out group-hover:scale-[1.02]"
            src={tools.src}
            alt={tools.alt}
            width="1800"
            height="1200"
            loading="lazy"
            decoding="async"
          />
          <figcaption class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-4 bg-gradient-to-t from-ink/80 to-transparent p-5 pt-14 text-white-soft sm:p-6 sm:pt-16">
            <span class="font-display text-3xl font-semibold uppercase leading-none sm:text-4xl">Herramientas listas</span>
          </figcaption>
        </figure>

      </div>

      <div class="mt-8 grid overflow-hidden border border-ink/15 sm:mt-12 sm:grid-cols-[1.05fr_0.95fr]">
        <figure class="group relative min-h-[15rem] overflow-hidden bg-ink-raised sm:min-h-[14rem] lg:min-h-[16rem]">
          <img
            class="absolute inset-0 h-full w-full object-cover object-[center_65%] transition-transform duration-200 ease-out group-hover:scale-[1.02]"
            src={business.media.billiards.src}
            alt={business.media.billiards.alt}
            width="1440"
            height="1440"
            loading="lazy"
            decoding="async"
          />
          <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/75 to-transparent p-4 pt-12 font-display text-2xl font-semibold uppercase text-white-soft">
            Billar
          </figcaption>
        </figure>
        <div class="flex flex-col justify-center gap-3 bg-ink p-6 text-white-soft sm:p-8">
          <h3 class="font-display text-3xl font-bold uppercase leading-[0.9] sm:text-4xl">Un rato más.</h3>
          <p class="max-w-[28ch] text-sm leading-6 text-white-soft/75">{business.amenityNote}</p>
        </div>
      </div>
    </div>
  </div>
</section>
