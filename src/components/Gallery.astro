---
import { business } from '../data/business';

const [fade, barber, tools] = business.media.gallery;

const galleryItems = [
  { image: fade, title: 'Corte al detalle', layout: 'feature' },
  { image: barber, title: 'El barbero', layout: 'side-top' },
  { image: tools, title: 'Herramientas preparadas', layout: 'side-bottom' },
];
---

<section id="trabajo" class="scroll-mt-8 bg-paper py-20 text-ink sm:pt-28 lg:pt-36">
  <div class="page-gutter">
    <div class="content-width">
      <div class="mb-10 grid gap-7 border-b border-ink/20 pb-8 sm:mb-14 sm:grid-cols-[1.2fr_0.8fr] sm:items-end sm:pb-10">
        <div>
          <h2 class="font-display mt-4 max-w-[18ch] text-[clamp(2.8rem,5vw,4.75rem)] font-bold uppercase leading-[0.92] tracking-[-0.02em] text-ink [text-wrap:balance]">
            Corte limpio<br />Estilo propio
          </h2>
        </div>
        <div class="sm:justify-self-end sm:pb-1 sm:text-right">
          <p class="max-w-[28rem] text-sm leading-7 text-ink/75 sm:text-base">
            Un vistazo al trabajo de El Tonsor del Cesar.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-[0.9fr_1.1fr] lg:auto-rows-[17rem] lg:gap-7">
        {galleryItems.map(({ image, title, layout }) => (
          <figure
            class:list={[
              'group relative min-h-[22rem] overflow-hidden bg-ink-raised sm:min-h-[26rem] lg:min-h-0',
              layout === 'feature' && 'sm:col-span-2 lg:col-span-1 lg:row-span-2',
              layout === 'side-top' && 'lg:col-start-2 lg:row-start-1',
              layout === 'side-bottom' && 'lg:col-start-2 lg:row-start-2',
            ]}
          >
            <img
              class:list={[
                'absolute inset-0 h-full w-full object-cover transition-transform duration-200 ease-out group-hover:scale-[1.02]',
                layout === 'feature' && 'object-[center_44%]',
                layout === 'side-top' && 'object-[center_0%]',
                layout === 'side-bottom' && 'object-[center_58%]',
              ]}
              src={image.src}
              alt={image.alt}
              loading="lazy"
              decoding="async"
            />
            <figcaption class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-4 bg-gradient-to-t from-ink/85 to-transparent p-5 pt-16 text-white-soft sm:p-7 sm:pt-20">
              <span class="font-display text-3xl font-semibold uppercase leading-none sm:text-4xl">{title}</span>
              {image.provisional && (
                <span class="font-sans mb-0.5 shrink-0 text-[0.65rem] font-semibold uppercase tracking-[0.12em] text-white-soft/80">
                  Imagen provisional
                </span>
              )}
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </div>
</section>

<section aria-labelledby="ambiente-title" class="bg-ink py-12 text-copy sm:py-16">
  <div class="page-gutter">
    <div class="content-width grid items-center gap-7 sm:gap-9 lg:grid-cols-[0.9fr_1.1fr] lg:gap-12">
      <div class="max-w-xl">
        <h2 id="ambiente-title" class="font-display text-[clamp(2rem,3.5vw,3.25rem)] font-semibold uppercase leading-[0.95] text-white-soft [text-wrap:balance]">
          Una partida después del corte.
        </h2>
        <p class="mt-4 max-w-md text-sm leading-7 text-muted sm:text-base">
          {business.amenityNote}
        </p>
      </div>

      <figure class="group relative min-h-[12rem] overflow-hidden bg-ink-raised sm:min-h-[16rem] lg:min-h-[18rem]">
        <img
          class="absolute inset-0 h-full w-full object-cover object-[center_58%] transition-transform duration-200 ease-out group-hover:scale-[1.02]"
          src={business.media.billiards.src}
          alt={business.media.billiards.alt}
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </div>
</section>

<div class="h-20 bg-paper sm:h-28 lg:h-32" aria-hidden="true"></div>
