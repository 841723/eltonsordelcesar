---
import { business, hasBooking } from '../data/business';

const bookingHref = hasBooking ? business.bookingUrl : '#visitanos';
const bookingTarget = hasBooking && business.bookingUrl.startsWith('http') ? '_blank' : undefined;
---

<header class="absolute inset-x-0 top-0 z-20 page-gutter pt-5 text-copy md:pt-7">
  <div class="content-width">
    <div class="flex min-h-12 items-center justify-between gap-5">
      <a href="#inicio" class="group inline-flex min-h-11 items-center gap-3" aria-label={`${business.name}, inicio`}>
        <img
          class="block h-12 w-[3.8rem] object-contain transition-opacity duration-150 group-hover:opacity-80 sm:h-14 sm:w-[4.5rem]"
          src={business.logos.onDark}
          alt={business.name}
          width="829"
          height="654"
        />
      </a>

      <a
        class="inline-flex min-h-11 items-center justify-center border border-tonsor-orange/75 px-4 font-sans text-[0.65rem] font-bold uppercase tracking-[0.14em] text-tonsor-orange transition-colors duration-150 hover:bg-tonsor-orange hover:text-ink sm:px-5"
        href={bookingHref}
        target={bookingTarget}
        rel={bookingTarget ? 'noreferrer' : undefined}
      >
        Reservar cita
      </a>
    </div>

  </div>
</header>
