---
import '../styles/global.css';
import { business, publicAssetPath } from '../data/business';

interface Props {
  title?: string;
}

const { title = 'El Tonsor del Cesar · Barbería en Villanueva de Gallego' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#211f1c" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={business.favicon.onLight} />
    <link rel="icon" type="image/svg+xml" href={business.favicon.onDark} media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" sizes="180x180" href={publicAssetPath('apple-touch-icon.png')} />
    <link rel="preload" as="image" href={business.media.hero.src} fetchpriority="high" />
  </head>
  <body>
    <slot />
  </body>
</html>
